homelab:
  root: "~/"
  launch_strategy: in_place
  layout:
    -
      - sh "$HOME/.config/matejkosiarcik/bin/mert-connect-to-server" 'homelab@server-odroid-h4-ultra.matejhome.com'
      - sh "$HOME/.config/matejkosiarcik/bin/mert-connect-to-server" 'homelab@server-odroid-h3.matejhome.com'
    -
      - sh "$HOME/.config/matejkosiarcik/bin/mert-connect-to-server" 'homelab@server-raspberry-pi-4b-4g.matejhome.com'
      - sh "$HOME/.config/matejkosiarcik/bin/mert-connect-to-server" 'homelab@server-raspberry-pi-4b-2g.matejhome.com'

local-homelab:
  root: "~/"
  launch_strategy: in_place
  layout:
    -
      - cd "$HOME/Dev/Personal/github/homelab/servers/odroid-h4-ultra"
      - cd "$HOME/Dev/Personal/github/homelab/servers/odroid-h3"
    -
      - cd "$HOME/Dev/Personal/github/homelab/servers/raspberry-pi-4b-2g"
      - cd "$HOME/Dev/Personal/github/homelab/servers/raspberry-pi-4b-4g"
